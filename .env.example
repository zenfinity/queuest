# Origin for Open Graph link previews (e.g., https://queuest.app)
# Required for social media sharing preview images to render
PUBLIC_ORIGIN=

# TMDB API key — https://developer.themoviedb.org/docs/getting-started
TMDB_API_KEY=

# Fine-grained GitHub PAT with Issues: Read & write on zenfinity/streamq
# Required only for in-app feedback (Settings → Send feedback)
GITHUB_TOKEN=
